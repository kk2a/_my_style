\newcommand{\MyStatementTitle}[3]{%
  \textbf{#1\ #2%
  \if\relax\detokenize{#3}\relax
  \else
    \ (#3)%
  \fi
  .}
}

\NewDocumentEnvironment{MyTheorem}{O{} O{\arabic{MyTheoremCounter}}}{%
  \stepcounter{MyAllCounter}%
  \stepcounter{MyAllCounterWithoutDef}%
  \refstepcounter{MyTheoremCounter}%
  \begin{tcolorbox}[colframe=blue,colback=blue!5,breakable,before skip=10pt,after skip=10pt]
    \MyStatementTitle{定理}{\theMyAllCounter}{#1}\label{thm:#2}\ 
  }{%
    \end{tcolorbox}
  }

\NewDocumentEnvironment{MyLemma}{O{} O{\arabic{MyLemmaCounter}}}{%
  \stepcounter{MyAllCounter}%
  \stepcounter{MyAllCounterWithoutDef}%
  \refstepcounter{MyLemmaCounter}%
  \begin{tcolorbox}[colframe=red,colback=red!4,breakable,before skip=10pt,after skip=10pt]
    \MyStatementTitle{補題}{\theMyAllCounter}{#1}\label{lem:#2}\ 
  }{%
    \end{tcolorbox}
  }

\NewDocumentEnvironment{MyProposition}{O{} O{\arabic{MyPropositionCounter}}}{%
  \stepcounter{MyAllCounter}%
  \stepcounter{MyAllCounterWithoutDef}%
  \refstepcounter{MyPropositionCounter}%
  \begin{tcolorbox}[colframe=red,colback=red!4,breakable,before skip=10pt,after skip=10pt]
    \MyStatementTitle{命題}{\theMyAllCounter}{#1}\label{prop:#2}\ 
  }{%
    \end{tcolorbox}
  }

\NewDocumentEnvironment{MyCorollary}{O{} O{\arabic{MyCorollaryCounter}}}{%
  \stepcounter{MyAllCounter}%
  \stepcounter{MyAllCounterWithoutDef}%
  \refstepcounter{MyCorollaryCounter}%
  \begin{tcolorbox}[colframe=red,colback=red!4,breakable,before skip=10pt,after skip=10pt]
    \MyStatementTitle{系}{\theMyAllCounter}{#1}\label{cor:#2}\ 
  }{%
    \end{tcolorbox}
  }

\NewDocumentEnvironment{MyClaim}{O{} O{\arabic{MyClaimCounter}}}{%
  \refstepcounter{MyClaimCounter}%
  \begin{tcolorbox}[colframe=black,colback=white,breakable,before skip=10pt,after skip=10pt]
    \MyStatementTitle{Claim}{\theMyClaimCounter}{#1}\label{clm:#2}\ 
  }{%
    \end{tcolorbox}
  }

\NewDocumentEnvironment{MyDefinition}{O{} O{\arabic{MyDefinitionCounter}}}{%
  \stepcounter{MyAllCounter}%
  \refstepcounter{MyDefinitionCounter}%
  \begin{tcolorbox}[colframe=black,colback=white,breakable,before skip=10pt,after skip=10pt]
    \MyStatementTitle{定義}{\theMyAllCounter}{#1}\label{dfn:#2}\ 
  }{%
    \end{tcolorbox}
  }
